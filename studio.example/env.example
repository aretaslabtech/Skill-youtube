# Secrets for the video studio. This file is gitignored; keep it mode 600 and never commit it.

# The voice runs locally (config.json "voice"); it needs no key here.

# Optional: a Hugging Face token for the gated voice models, if you didn't run `hf auth login`.
HF_TOKEN=

# Optional: only for HyperFrames' own music/SFX retrieval. The voice never uses it.
HEYGEN_API_KEY=

# Optional: deliver each video and its post kit to Telegram. Without these, the kit is saved
# next to the video as POST-KIT.html. Create a bot with @BotFather, send it a message, then
# read your chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
